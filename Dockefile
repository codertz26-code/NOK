FROM node:18-slim

# Install dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    git \
    ffmpeg \
    imagemagick \
    webp \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --production
RUN npm install sharp --force

# Copy app source
COPY . .

# Create necessary directories
RUN mkdir -p sessions session_backups temp_sessions

# Expose port
EXPOSE $PORT

# Start the bot
CMD ["node", "index.js"]